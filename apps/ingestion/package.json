{
  "name": "@informes/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/local-run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "download": "tsx src/local-run.ts download",
    "parse": "tsx src/local-run.ts parse"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/client-sqs": "^3.620.0",
    "@aws-sdk/client-ses": "^3.620.0",
    "@aws-sdk/client-sns": "^3.620.0",
    "@aws-sdk/client-textract": "^3.620.0",
    "@informes/db": "workspace:*",
    "@informes/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.143",
    "@types/node": "^20.14.14",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
