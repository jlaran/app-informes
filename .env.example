# ---------------------------------------------------------------------------
# Variables de entorno de ejemplo. Copie a .env y complete los valores.
# En AWS, estos valores provienen de SSM Parameter Store / Secrets Manager.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Base de datos (Aurora PostgreSQL) ---
# Usuario de aplicacion (NO superusuario): la RLS depende de que este rol
# NO tenga BYPASSRLS.
DATABASE_URL=postgresql://informes_app:changeme@localhost:5432/informes?schema=public

# --- AWS ---
AWS_REGION=us-east-1
# Bucket donde se guardan los PDF crudos de los boletines
S3_RAW_BOLETINES_BUCKET=informes-raw-boletines-dev
# Cola de parsing
SQS_PARSE_QUEUE_URL=
# Cola de evaluacion de alertas
SQS_ALERTS_QUEUE_URL=

# --- Cognito (auth multi-tenant) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# --- Ingesta (fuente Nexus PJ) ---
# Base del buscador del Poder Judicial. Los selectores/endpoint reales deben
# validarse desde dentro de la VPC (esta plataforma se accede desde CR).
NEXUS_PJ_BASE_URL=https://nexuspj.poder-judicial.go.cr
# Cadena de busqueda para filtrar solo Boletin Judicial
NEXUS_PJ_QUERY=tipoInformacion:(Boletín AND Judicial)

# --- Notificaciones ---
SES_FROM_EMAIL=alertas@informes.example.com
SNS_ALERTS_TOPIC_ARN=

# --- API ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
