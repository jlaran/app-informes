// Esquema de datos — Plataforma de Boletines Judiciales (Costa Rica)
// Documentación conceptual: docs/DATA_MODEL.md
//
// Dos planos:
//   * Plano PÚBLICO  (compartido, sin tenant_id): boletines y avisos.
//   * Plano de TENANT (aislado por tenant_id + RLS): tenants, usuarios, alertas.
//
// La Row-Level Security se aplica en una migración SQL aparte
// (prisma/migrations/*/rls.sql) porque Prisma no modela políticas RLS.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, uuidOssp(map: "uuid-ossp"), citext]
}

// ===========================================================================
// ENUMS  (deben coincidir con packages/shared/src/enums.ts)
// ===========================================================================

enum NoticeCategory {
  PROPERTY_AUCTION
  VEHICLE_AUCTION
  DECEASED
  DISSOLVED_COMPANY
}

enum BoletinStatus {
  PENDING
  DOWNLOADED
  PARSING
  PARSED
  FAILED
}

enum RemateNumber {
  FIRST
  SECOND
  THIRD
}

enum AlertChannel {
  EMAIL
  PUSH
  SMS
}

enum MatchStatus {
  PENDING
  SENT
  FAILED
}

enum Currency {
  CRC
  USD
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum TenantPlan {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

// ===========================================================================
// PLANO PÚBLICO — datos compartidos de los boletines
// ===========================================================================

/// Una edición del Boletín Judicial descargada de la fuente (Nexus PJ).
model Boletin {
  id          String        @id @default(uuid()) @db.Uuid
  numero      String // número de edición del boletín
  publishedAt DateTime      @map("published_at") @db.Timestamptz(3)
  sourceUrl   String?       @map("source_url")
  s3RawKey    String?       @map("s3_raw_key") // llave del PDF crudo en S3
  pageCount   Int?          @map("page_count")
  status      BoletinStatus @default(PENDING)
  error       String? // último error de ingesta, si aplica
  parsedAt    DateTime?     @map("parsed_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  notices Notice[]

  @@unique([numero, publishedAt])
  @@index([publishedAt])
  @@index([status])
  @@map("boletines")
}

/// Aviso individual extraído de un boletín. Tabla base; se especializa 1:1
/// según `category` en una de las cuatro tablas de detalle.
model Notice {
  id          String         @id @default(uuid()) @db.Uuid
  boletinId   String         @map("boletin_id") @db.Uuid
  category    NoticeCategory
  page        Int?
  expediente  String? // número de expediente judicial
  despacho    String? // juzgado / despacho que emite
  publishedAt DateTime       @map("published_at") @db.Timestamptz(3)
  rawText     String         @map("raw_text") @db.Text
  /// sha256(boletin_id || expediente || texto normalizado) — idempotencia
  contentHash String         @map("content_hash")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  boletin          Boletin           @relation(fields: [boletinId], references: [id], onDelete: Cascade)
  propertyAuction  PropertyAuction?
  vehicleAuction   VehicleAuction?
  deceasedPerson   DeceasedPerson?
  dissolvedCompany DissolvedCompany?
  matches          AlertMatch[]
  savedBy          SavedNotice[]

  @@unique([contentHash])
  @@index([category, publishedAt])
  @@index([boletinId])
  @@index([expediente])
  @@map("notices")
}

/// Remate de bien inmueble (propiedades, casas, fincas, lotes).
model PropertyAuction {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @unique @map("notice_id") @db.Uuid

  propertyType String? @map("property_type") // casa, finca, lote, edificio...
  provincia    String?
  canton       String?
  distrito     String?
  /// Ubicación normalizada (unaccent + minúsculas) para búsqueda difusa.
  locationNorm String? @map("location_norm")
  matricula    String? // matrícula de folio real / partido
  areaM2       Decimal? @map("area_m2") @db.Decimal(12, 2)

  basePrice   BigInt?      @map("base_price") // en céntimos (unidad menor)
  currency    Currency     @default(CRC)
  remateNumber RemateNumber? @map("remate_number")
  remateDate  DateTime?    @map("remate_date") @db.Timestamptz(3)

  demandado String?
  actor     String?

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([provincia, canton, distrito])
  @@index([basePrice])
  @@index([remateDate])
  @@map("property_auctions")
}

/// Remate de vehículo.
model VehicleAuction {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @unique @map("notice_id") @db.Uuid

  placa     String?
  brand     String? // marca
  brandNorm String? @map("brand_norm")
  model     String?
  year      Int?

  basePrice    BigInt?       @map("base_price") // en céntimos
  currency     Currency      @default(CRC)
  remateNumber RemateNumber? @map("remate_number")
  remateDate   DateTime?     @map("remate_date") @db.Timestamptz(3)

  demandado String?
  actor     String?

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([brand])
  @@index([year])
  @@index([basePrice])
  @@index([remateDate])
  @@map("vehicle_auctions")
}

/// Persona fallecida (proceso sucesorio).
model DeceasedPerson {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @unique @map("notice_id") @db.Uuid

  fullName       String  @map("full_name")
  fullNameNorm   String  @map("full_name_norm") // unaccent + minúsculas
  cedula         String?
  cedulaNorm     String? @map("cedula_norm") // solo dígitos
  fechaDefuncion DateTime? @map("fecha_defuncion") @db.Timestamptz(3)
  sucesorioTipo  String?  @map("sucesorio_tipo")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([cedulaNorm])
  @@index([fullNameNorm])
  @@map("deceased_persons")
}

/// Sociedad disuelta.
model DissolvedCompany {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @unique @map("notice_id") @db.Uuid

  companyName        String  @map("company_name")
  companyNameNorm    String  @map("company_name_norm")
  cedulaJuridica     String? @map("cedula_juridica")
  cedulaJuridicaNorm String? @map("cedula_juridica_norm") // solo dígitos
  dissolutionType    String? @map("dissolution_type")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([cedulaJuridicaNorm])
  @@index([companyNameNorm])
  @@map("dissolved_companies")
}

// ===========================================================================
// PLANO DE TENANT — aislado por tenant_id + RLS
// ===========================================================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(FREE)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users  User[]
  alerts Alert[]

  @@map("tenants")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  cognitoSub String   @unique @map("cognito_sub")
  email      String   @db.Citext
  name       String?
  role       UserRole @default(MEMBER)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alerts       Alert[]
  savedNotices SavedNotice[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Regla de alerta. `criteria` es JSONB validado por categoría en la app
/// (packages/shared/src/criteria.ts).
model Alert {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  name      String
  category  NoticeCategory
  channel   AlertChannel   @default(EMAIL)
  criteria  Json           @db.JsonB
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches AlertMatch[]

  @@index([tenantId])
  @@index([category, isActive])
  @@map("alerts")
}

/// Coincidencia entre una alerta y un aviso. Evita re-notificar.
model AlertMatch {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  alertId    String      @map("alert_id") @db.Uuid
  noticeId   String      @map("notice_id") @db.Uuid
  status     MatchStatus @default(PENDING)
  matchedAt  DateTime    @default(now()) @map("matched_at") @db.Timestamptz(3)
  notifiedAt DateTime?   @map("notified_at") @db.Timestamptz(3)
  error      String?

  alert  Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([alertId, noticeId])
  @@index([tenantId])
  @@index([status])
  @@map("alert_matches")
}

/// Aviso guardado/marcado por un usuario.
model SavedNotice {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  noticeId  String   @map("notice_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([tenantId])
  @@map("saved_notices")
}
